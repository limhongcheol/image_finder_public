# The Android emulator can use http://10.0.2.2:8080.
# For a physical phone, enter the address of your own API server.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Optional Expo push configuration. Never put private keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Paths are build-time inputs; credential files stay outside version control.
GOOGLE_SERVICES_FILE=
