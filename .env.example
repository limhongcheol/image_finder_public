# Gemini through Vertex AI (used by search, agents and caption generation)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repository/service-account.json
GEMINI_MODEL=gemini-2.5-flash
# Only the optional dataset filter uses a Gemini Developer API key.
GEMINI_API_KEY=

# API server
LUMINA_HOST=127.0.0.1
LUMINA_PORT=8080
LUMINA_SECRET_KEY=
LUMINA_PASSWORD=
LUMINA_REQUIRE_AUTH=0
LUMINA_AI_SERVER_URL=http://127.0.0.1:8090
LUMINA_TIME_MODEL_URL=http://127.0.0.1:5000

# AI worker and SFTP transport to the API server
AI_HOST=127.0.0.1
AI_PORT=8090
AI_SSH_HOST=127.0.0.1
AI_SSH_PORT=22
AI_SSH_USER=
AI_SSH_PASS=
AI_REMOTE_BASE=/absolute/path/to/backend
AI_API_SERVER_URL=http://127.0.0.1:8080

# Optional overrides: local photos, AdaFace weights and labeled benchmark data
# LUMINA_PHOTO_ROOT=/absolute/path/to/photos
# ADAFACE_CKPT=/absolute/path/to/adaface_ir101_webface12m.ckpt
# LUMINA_LABELED_FACES=/absolute/path/to/labeled-faces
# LUMINA_PERSON_ZERO_AGE=

# Time prediction: match the backbone and probe used to create your weights.
QWEN_MODEL_ID=Qwen/Qwen3.5-9B
# LUMINA_TIME_WEIGHTS=/absolute/path/to/best_layer_9.pth
# AI_PREDICT_MODEL_PATH=/absolute/path/to/best_layer_9.pth
# LUMINA_IMAGES_DIR=/absolute/path/to/images
# LUMINA_DATASET_CSV=/absolute/path/to/dataset.csv
# LUMINA_EMBEDDINGS_DIR=/absolute/path/to/embeddings
